<Project Sdk="Microsoft.NET.Sdk">

  <!-- Desktop-only tools (never ships on Android). CLI entry point (Program),
       test harnesses (Testing/), content repackers (Utility/Repack*), analyzer,
       console setup, and the Blender/COLLADA scripting export. References the
       runtime core; keeps the same MphRead namespaces (no using churn), reaching
       runtime internals via [InternalsVisibleTo] declared in the runtime. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>MphRead.Tools</AssemblyName>
    <RootNamespace>MphRead</RootNamespace>
    <DebugType>embedded</DebugType>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MphRead\MphRead.csproj" />
    <!-- Our systems (Save/Config/Sim/Mods/Input/Game/Assets/World) + their test harnesses. -->
    <ProjectReference Include="..\MphRecomp.Core\MphRecomp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="paths.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Replay R2c (docs/REPLAY_MODE.md): `dotnet build ... -p:ReplayGolden=true` plays the golden replays in
       tests/replays/ after the build (~10 s) and fails the build if one no longer plays exactly, i.e. the game logic
       changed (bump ReplayFile.CurrentSimVersion and re-record if that was intended). Opt-in; needs the desktop
       extraction (skipped without it). -->
  <Target Name="ReplayGolden" AfterTargets="Build"
          Condition="'$(ReplayGolden)' == 'true' And Exists('$(MSBuildThisFileDirectory)..\MphRead\bin\Debug\net9.0\paths.txt')">
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(TargetPath)&quot; -replaygolden" WorkingDirectory="$(OutDir)" />
  </Target>

</Project>
