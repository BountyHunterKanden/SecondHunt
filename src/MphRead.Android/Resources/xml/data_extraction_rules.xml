<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device-to-device transfer (AndroidManifest.xml dataExtractionRules): the player's
     saves and settings only, never the extracted ROM or imported game data. Keep in step with backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="external" path="saves" />
        <include domain="external" path="recomp_settings.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="external" path="saves" />
        <include domain="external" path="recomp_settings.json" />
    </device-transfer>
</data-extraction-rules>
