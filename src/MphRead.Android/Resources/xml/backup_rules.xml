<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6-11 backup (AndroidManifest.xml fullBackupContent): the player's saves and settings only, never the
     extracted ROM or imported game data. Keep in step with data_extraction_rules.xml. -->
<full-backup-content>
    <include domain="external" path="saves" />
    <include domain="external" path="recomp_settings.json" />
</full-backup-content>
