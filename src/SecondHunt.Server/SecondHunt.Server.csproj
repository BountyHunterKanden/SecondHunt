<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The online server (docs/ONLINE_PLAY.md): friend codes, names, friends/rivals, presence, later lobbies, matchmaking,
       chat and the UDP relay. It holds no game data. It compiles the game's own protocol files (linked below, not
       copies, like SecondHunt.ReleaseTool links Update/), so the game and the server can't disagree about a message.
       Implicit usings are off, as in MphRecomp.Core, so the linked files are checked the way the game compiles them.
       Run and test: see Program.cs (the selftest switch runs the PC checks). -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <AssemblyName>SecondHuntServer</AssemblyName>
    <RootNamespace>SecondHunt.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\MphRecomp.Core\Online\*.cs" Link="Online\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- the word lists (LDNOOBW, CC BY 4.0; see wordlists/README.md): copied beside the program for the self-test and deploy -->
    <None Include="wordlists\*" CopyToOutputDirectory="PreserveNewest" LinkBase="wordlists" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.9" />
  </ItemGroup>

</Project>
