[Unit]
Description=Second Hunt online server (friends, lobbies, match relay)
After=network-online.target
Wants=network-online.target

[Service]
User=secondhunt
Group=secondhunt
WorkingDirectory=/var/lib/secondhunt
# the web side listens only on this machine (Caddy in front does HTTPS); the relay is UDP 47780 on every address
ExecStart=/opt/secondhunt/SecondHuntServer --urls http://127.0.0.1:8080 --db /var/lib/secondhunt/secondhunt.db --words /opt/secondhunt/words.txt --relay-port 47780
Restart=always
RestartSec=2
# the single-file build unpacks its native SQLite library here
Environment=DOTNET_BUNDLE_EXTRACT_BASE_DIR=/var/lib/secondhunt/.net
# the Cloudflare TURN key (TURN_KEY_ID=..., TURN_KEY_API_TOKEN=...), root-only, never in the repo; "-" = optional
EnvironmentFile=-/etc/secondhunt/turn.env
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/secondhunt
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
