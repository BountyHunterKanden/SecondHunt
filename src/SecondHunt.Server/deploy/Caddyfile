# setup.sh writes this to /etc/caddy/Caddyfile with {SITE} = the domain (HTTPS, certificate automatic) or :80 (no
# domain yet: plain HTTP on the server's IP). Caddy passes WebSockets through on its own.
{SITE} {
	handle /v1/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		respond "Second Hunt server" 200
	}
}
